# ----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./maching.db

# ----------------------------------------------------------------------------
# 2. 大模型 API（核心，必填）

# 示例 DeepSeek
LLM_API_KEY="your_deepseek_api_key_here"  # 请替换为你的 DeepSeek API Key   
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=your_deepseek_model_here  # 请替换为你想使用的 DeepSeek 模型名称  

# 相关性评分 / 路由模型（可选，默认复用主模型）
GRADE_MODEL=

# 图谱抽取(LightRAG)专属模型（可选，默认复用 LLM_MODEL）
LIGHTRAG_LLM_MODEL=

# ----------------------------------------------------------------------------
# 3. 向量模型（本地，无需密钥）
# 使用本地 bge-m3 生成 dense + BM25 sparse 双向量，CPU 行。
# ----------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
# HuggingFace 镜像（国内网络）。如需官方源可留空。
HF_ENDPOINT=https://hf-mirror.com
# BM25 词表/df 持久化路径（默认 data/bm25_state.json，一般无需改）
# BM25_STATE_PATH=./data/bm25_state.json

# ----------------------------------------------------------------------------
# 4. Milvus 向量库（Docker 服务，非密钥）
# 已在 docker-compose 中启动；如独立部署改这里。
# ----------------------------------------------------------------------------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=embeddings_collection
DENSE_EMBEDDING_DIM=1024

# ----------------------------------------------------------------------------
# 5. Redis 缓存（Docker 服务，非密钥）
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=supermew
REDIS_CACHE_TTL_SECONDS=300

# ----------------------------------------------------------------------------
# 6. 知识图谱 Neo4j + LightRAG（Docker 服务）
# ----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lightrag2026
NEO4J_USERNAME=neo4j
LIGHTRAG_WORKING_DIR=./data/lightrag
LIGHTRAG_WORKSPACE=maching_main
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
SUMMARY_LANGUAGE=Chinese

# ----------------------------------------------------------------------------
# 7. 重排 Rerank（可选，留空则跳过 rerank）
# 仅在部署了兼容 /v1/rerank 的 rerank 服务时填写。
# ----------------------------------------------------------------------------
RERANK_MODEL=
RERANK_BINDING_HOST=
RERANK_API_KEY=

# ----------------------------------------------------------------------------
# 8. 检索增强参数（可选，有默认值）
# ----------------------------------------------------------------------------
AUTO_MERGE_ENABLED=true
AUTO_MERGE_THRESHOLD=2
LEAF_RETRIEVE_LEVEL=3

# ----------------------------------------------------------------------------
# 10. 认证 / 服务（可选，有默认值）
# ----------------------------------------------------------------------------
JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_INVITE_CODE=
PASSWORD_PBKDF2_ROUNDS=310000
HOST=0.0.0.0
PORT=8000

# ----------------------------------------------------------------------------
# 11. 上传任务看门狗（可选）
# running 状态超过该秒数无更新则自动标记为失败，避免前端永久卡百分比。
# ----------------------------------------------------------------------------
UPLOAD_JOB_STUCK_TIMEOUT=1800



